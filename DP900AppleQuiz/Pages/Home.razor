@page "/"
@implements IDisposable

<PageTitle>DP-900 Apple Quiz</PageTitle>

<h1>DP-900 Apple Quiz</h1>

<div class="game-shell">
    <div class="status-bar">
        <div><strong>問題:</strong> @(_currentIndex + 1) / @_questions.Count</div>
        <div><strong>正解数:</strong> @_score</div>
        <div><strong>ミス:</strong> @_misses / @MaxMisses</div>
        <div class="timer"><strong>残り:</strong> @_secondsLeft 秒</div>
    </div>

    <svg viewBox="0 0 240 240" class="apple" role="img" aria-label="lives apple">
        <path d="M120 48c-7-19 2-33 18-43 2 17-5 34-18 43z" fill="#5e3b1f" />
        <path d="M127 58c10-14 27-16 40-10-7 8-17 14-29 16-4 1-8 0-11-6z" fill="#58a65c" />
        <ellipse cx="120" cy="138" rx="84" ry="88" fill="#d22f27" />
        <ellipse cx="92" cy="108" rx="20" ry="14" fill="#ef756f" opacity="0.7" />
        @if (_misses > 0)
        {
            <circle cx="184" cy="98" r="26" fill="#f5f5f5" />
        }
        @if (_misses > 1)
        {
            <circle cx="194" cy="134" r="28" fill="#f5f5f5" />
        }
        @if (_misses > 2)
        {
            <circle cx="178" cy="168" r="26" fill="#f5f5f5" />
        }
        @if (_misses > 3)
        {
            <circle cx="152" cy="190" r="24" fill="#f5f5f5" />
        }
        @if (_misses > 4)
        {
            <circle cx="120" cy="138" r="90" fill="#f5f5f5" />
        }
    </svg>

    @if (_isGameOver)
    {
        <p class="result lose">ゲームオーバー: リンゴが食べ尽くされました。</p>
        <button class="primary" @onclick="RestartGame">もう一度遊ぶ</button>
    }
    else if (_isCompleted)
    {
        <p class="result win">クリア! 全問終了（正解数: @_score / @_questions.Count）</p>
        <button class="primary" @onclick="RestartGame">もう一度遊ぶ</button>
    }
    else
    {
        var current = _questions[_currentIndex];
        <div class="question-card">
            <p class="question-text">@current.Prompt</p>
            <div class="choices">
                @foreach (var choice in current.Choices)
                {
                    <button class="choice"
                            disabled="@(!_acceptingAnswer)"
                            @onclick="() => SubmitAnswer(choice.Key)">
                        <span class="choice-key">@choice.Key.</span> @choice.Value
                    </button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <p class="feedback">@_feedback</p>
            }
            @if (_canMoveNext)
            {
                <button class="primary" @onclick="NextQuestion">次の問題へ</button>
            }
        </div>
    }
</div>

@code {
    private const int MaxMisses = 5;
    private const int SecondsPerQuestion = 20;

    private readonly List<QuizQuestion> _sourceQuestions =
    [
        new("dp900-q001", "Azure SQL Database は主にどの種類のデータを扱うサービスですか？", new Dictionary<string, string>
        {
            ["A"] = "リレーショナルデータ",
            ["B"] = "キー/バリュー形式のみ",
            ["C"] = "グラフデータ専用",
            ["D"] = "時系列データ専用"
        }, "A"),
        new("dp900-q002", "大量データの分析向けにデータレイクとデータウェアハウスを統合して扱える Azure サービスはどれですか？", new Dictionary<string, string>
        {
            ["A"] = "Azure Synapse Analytics",
            ["B"] = "Azure DNS",
            ["C"] = "Azure DevTest Labs",
            ["D"] = "Azure Virtual Network"
        }, "A"),
        new("dp900-q003", "Power BI の主な役割として最も適切なのはどれですか？", new Dictionary<string, string>
        {
            ["A"] = "データの可視化とレポート作成",
            ["B"] = "仮想マシンの自動スケーリング",
            ["C"] = "NoSQL データの自動インデックス再構築",
            ["D"] = "ネットワークファイアウォールの設定管理"
        }, "A"),
        new("dp900-q004", "Azure Cosmos DB の特徴として適切なのはどれですか？", new Dictionary<string, string>
        {
            ["A"] = "グローバル分散可能な NoSQL データベース",
            ["B"] = "オンプレミス専用の SQL Server 管理ツール",
            ["C"] = "バッチ処理専用のジョブスケジューラ",
            ["D"] = "SMTP メール配信専用サービス"
        }, "A"),
        new("dp900-q005", "DP-900 の文脈で \"構造化データ\" の例として最も適切なのはどれですか？", new Dictionary<string, string>
        {
            ["A"] = "表形式の顧客マスタ（列と行）",
            ["B"] = "自由形式の監視ログ文章",
            ["C"] = "画像ファイル",
            ["D"] = "音声ファイル"
        }, "A")
    ];

    private List<QuizQuestion> _questions = [];
    private int _currentIndex;
    private int _score;
    private int _misses;
    private int _secondsLeft = SecondsPerQuestion;
    private string _feedback = string.Empty;
    private bool _acceptingAnswer = true;
    private bool _canMoveNext;
    private bool _isGameOver;
    private bool _isCompleted;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        RestartGame();
    }

    private void RestartGame()
    {
        StopTimer();
        _questions = _sourceQuestions.OrderBy(_ => Random.Shared.Next()).ToList();
        _currentIndex = 0;
        _score = 0;
        _misses = 0;
        _feedback = string.Empty;
        _acceptingAnswer = true;
        _canMoveNext = false;
        _isGameOver = false;
        _isCompleted = false;
        _secondsLeft = SecondsPerQuestion;
        StartTimer();
    }

    private void StartTimer()
    {
        StopTimer();
        _timer = new Timer(OnTimerTick, null, 1000, 1000);
    }

    private void OnTimerTick(object? _)
    {
        if (_isGameOver || _isCompleted || !_acceptingAnswer)
        {
            return;
        }

        _secondsLeft--;
        if (_secondsLeft <= 0)
        {
            _secondsLeft = 0;
            ApplyMiss($"時間切れ！正解は {_questions[_currentIndex].CorrectChoice} でした。");
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void SubmitAnswer(string choiceKey)
    {
        if (!_acceptingAnswer || _isGameOver || _isCompleted)
        {
            return;
        }

        var current = _questions[_currentIndex];
        if (choiceKey == current.CorrectChoice)
        {
            _score++;
            _feedback = "正解！";
        }
        else
        {
            ApplyMiss($"不正解。正解は {current.CorrectChoice} です。");
        }

        _acceptingAnswer = false;
        _canMoveNext = true;
        StopTimer();
    }

    private void ApplyMiss(string message)
    {
        if (_isGameOver || _isCompleted)
        {
            return;
        }

        _misses++;
        _feedback = message;
        _acceptingAnswer = false;
        _canMoveNext = true;
        StopTimer();

        if (_misses >= MaxMisses)
        {
            _isGameOver = true;
            _canMoveNext = false;
        }
    }

    private void NextQuestion()
    {
        if (_isGameOver || _isCompleted)
        {
            return;
        }

        if (_currentIndex >= _questions.Count - 1)
        {
            _isCompleted = true;
            _canMoveNext = false;
            _acceptingAnswer = false;
            return;
        }

        _currentIndex++;
        _feedback = string.Empty;
        _acceptingAnswer = true;
        _canMoveNext = false;
        _secondsLeft = SecondsPerQuestion;
        StartTimer();
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    public void Dispose()
    {
        StopTimer();
    }

    private sealed record QuizQuestion(
        string Id,
        string Prompt,
        Dictionary<string, string> Choices,
        string CorrectChoice);
}
